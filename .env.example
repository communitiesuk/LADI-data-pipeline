# Azure APIM config for LADI
# Copy this to .env and fill in your values — never commit .env to git

LADI_APIM_BASE_URL=https://api.azc.test.communities.gov.uk/ladi/gpt-4-1
LADI_APIM_EMBEDDING_URL=https://api.azc.test.communities.gov.uk/ladi/text-embedding-3-large
LADI_APIM_API_VERSION=2024-10-21
LADI_APIM_TOKEN_SCOPE=api://api.azc.test.communities.gov.uk/.default
LADI_APIM_SUBSCRIPTION_KEY=<your_subscription_key_from_apim_portal>
